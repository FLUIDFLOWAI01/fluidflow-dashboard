# ---- Server-side only. Never prefix any of these with NEXT_PUBLIC_ ----

# Supabase project URL and the SERVICE ROLE key (Project Settings -> API). Keep the key secret.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Your FastAPI backend on Render, and the same value you set as DASHBOARD_API_KEY there.
BACKEND_URL=https://YOUR-BACKEND.onrender.com
DASHBOARD_API_KEY=

# Dashboard sign-in. SESSION_SECRET should be a long random string (32+ characters).
DASHBOARD_PASSWORD=
SESSION_SECRET=
